<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store entitlements (App Sandbox required by Apple).
  The renderer is packaged locally; API and radio requests are outbound only.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>M6T85HP76P.com.visiongo.megaradio</string>
  <key>com.apple.developer.team-identifier</key>
  <string>M6T85HP76P</string>
</dict>
</plist>
